# Database
# Lokal (SQLite):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# Railway / Production (PostgreSQL):
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend - https://resend.com/api-keys)
# Jika RESEND_API_KEY kosong, email berjalan dalam mode mock (hanya di-log, tidak terkirim).
RESEND_API_KEY=""
RESEND_FROM="Social Scheduler <onboarding@resend.dev>"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="52428800"

# Social Media API Keys (opsional - untuk integrasi nyata)
# Instagram / Facebook
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Twitter/X
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_BEARER_TOKEN=""

# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# YouTube
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ====== Monitor SIAKAD (status open/close perkuliahan) ======
# URL & kredensial login SIAKAD
SIAKAD_LOGIN_URL=""              # mis. https://siakad.kampus.ac.id/login
SIAKAD_PERKULIAHAN_URL=""        # halaman yang menampilkan status open/close perkuliahan
SIAKAD_USERNAME=""
SIAKAD_PASSWORD=""

# Nama field pada form login (sesuaikan dgn HTML SIAKAD Anda)
SIAKAD_USER_FIELD="username"     # mis. username / nim / user
SIAKAD_PASS_FIELD="password"     # mis. password / pass

# (Opsional) Token CSRF di form login
SIAKAD_CSRF_FIELD=""             # mis. _token (Laravel) -> kosongkan jika tidak ada
# SIAKAD_CSRF_REGEX=""           # regex custom utk ambil token; default cari input name=<field> value=...

# (Opsional) Field tambahan statis pada form login, format query string
# SIAKAD_EXTRA_FIELDS="login=1"

# Deteksi status: kata kunci (dipisah koma, tidak case-sensitive)
SIAKAD_OPEN_KEYWORDS="buka,dibuka,open,aktif"
SIAKAD_CLOSE_KEYWORDS="tutup,ditutup,closed,nonaktif,tidak aktif"
# (Opsional) Persempit pencarian ke bagian tertentu dari halaman dgn regex
# SIAKAD_SECTION_REGEX=""

# Pengingat & lain-lain
SIAKAD_REMINDER_MINUTES="5"      # kirim pengingat 1x setelah N menit dari perubahan
SIAKAD_TIMEZONE="Asia/Jakarta"
# SIAKAD_USER_AGENT=""           # override User-Agent jika diperlukan
# SIAKAD_CRON_SECRET=""          # token endpoint cron; default pakai NEXTAUTH_SECRET

# Telegram (dari @BotFather). Kosongkan -> mode mock (hanya di-log).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
