# Database
# Lokal (SQLite):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# Railway / Production (PostgreSQL):
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend - https://resend.com/api-keys)
# Jika RESEND_API_KEY kosong, email berjalan dalam mode mock (hanya di-log, tidak terkirim).
RESEND_API_KEY=""
RESEND_FROM="Social Scheduler <onboarding@resend.dev>"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="52428800"

# Social Media API Keys (opsional - untuk integrasi nyata)
# Instagram / Facebook
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Twitter/X
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_BEARER_TOKEN=""

# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# YouTube
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ====== Monitor SIAKAD (status Open/Tutup perkuliahan) ======
# Login EWAKo pakai captcha -> tidak bisa otomatis. Pakai COOKIE sesi:
# login manual di browser, buka halaman Perkuliahan, salin URL + header Cookie.
# (lihat PANDUAN-SIAKAD.md)
SIAKAD_PERKULIAHAN_URL="https://siakad.kallabs.ac.id/perkuliahan"
SIAKAD_COOKIE=""                 # tempel seluruh nilai header Cookie dari DevTools

# Deteksi status: kata kunci (dipisah koma, tidak case-sensitive)
SIAKAD_OPEN_KEYWORDS="open,buka,dibuka,aktif"
SIAKAD_CLOSE_KEYWORDS="tutup,ditutup,closed,nonaktif"

# Pengingat & lain-lain
SIAKAD_REMINDER_MINUTES="5"      # kirim pengingat 1x setelah N menit dari perubahan
SIAKAD_TIMEZONE="Asia/Jakarta"
# SIAKAD_USER_AGENT=""           # override User-Agent jika diperlukan
# SIAKAD_CRON_SECRET=""          # token endpoint cron; default pakai NEXTAUTH_SECRET

# Telegram (dari @BotFather). Kosongkan -> mode mock (hanya di-log).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
